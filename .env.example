# ============================================================
# SmartCity 360 — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://ajat39963_db_user:KecqPsZWaCY7frh8@ac-0dxxmnd-shard-00-00.v4h59ag.mongodb.net:27017,ac-0dxxmnd-shard-00-01.v4h59ag.mongodb.net:27017,ac-0dxxmnd-shard-00-02.v4h59ag.mongodb.net:27017/?ssl=true&replicaSet=atlas-sxeaa2-shard-0&authSource=admin&appName=Cluster0
MONGODB_DB_NAME=smartcity360

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Map Provider ─────────────────────────────────────────────
# Options: leaflet | mapbox | google
MAP_PROVIDER=leaflet
MAP_API_KEY=

# ── AI ───────────────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=

# ── File Storage (Cloudinary) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartcity360.com
SMTP_FROM_NAME=SmartCity 360

# ── Redis (for future real-time / caching) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Seeding ──────────────────────────────────────────────────
# Used only during development seeding — never real admin credentials
SEED_SUPER_ADMIN_EMAIL=superadmin@dev.local
SEED_SUPER_ADMIN_PASSWORD=DevPassword123!
SEED_CITY_NAME=Demo City
